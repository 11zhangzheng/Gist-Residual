# Example only. Do not store credentials here.
export FIDMEM_DATA_ROOT=/data/fidmem/datasets
export FIDMEM_MODEL_ROOT=/data/fidmem/models
export FIDMEM_CACHE_ROOT=/data/fidmem/cache
# Authority inputs must remain inside the repository root for sealed path/hash validation.
export FIDMEM_ARTIFACT_ROOT="$PWD/artifacts"
export FIDMEM_INFERENCE_BACKEND=transformers
export FIDMEM_GIT_COMMIT=<40-hex-clean-checkout-commit>
# Researcher-approved inputs; no automatic third-party video acquisition.
export FIDMEM_VIDEOMME_V2_RAW_ROOT=/data/fidmem/datasets/Video-MME-v2
export FIDMEM_VIDEOMME_V2_PREPARATION_ROOT=/data/fidmem/artifacts/dataset-preparation/videomme-v2-pilot-v1
export FIDMEM_VIDEOMME_V2_HUMAN_AUDIT_RESULT=/data/fidmem/artifacts/videomme-v2-human-audit-result.json
export FIDMEM_E01_RESULTS_ROOT="$PWD/artifacts/experiments/E01/<approved-run>/results"
export FIDMEM_AUTHORITY_DRAFT="$PWD/artifacts/authority/ProductionAuthorityDraft.json"
export FIDMEM_PRODUCTION_AUTHORITY="$PWD/artifacts/experiments/E02/<approved-run>/results/PRODUCTION_AUTHORITY.json"
export FIDMEM_CANARY_SELECTION_MANIFEST="$FIDMEM_E01_RESULTS_ROOT/canary_selection_manifest.json"
export FIDMEM_PROVIDER_REQUEST_MANIFEST="$PWD/artifacts/provider-requests/canary.jsonl"
export FIDMEM_PROVIDER_BACKEND_FACTORY=<approved-module.path:create_backend>
